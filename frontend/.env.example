VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# From goong.io dashboard -> Keys (REST API key, used for address autocomplete/geocoding)
VITE_GOONG_API_KEY=your-goong-api-key
# From goong.io dashboard -> Keys (Maptiles key, used to render the map tiles). Same key often works for both.
VITE_GOONG_MAPTILES_KEY=your-goong-maptiles-key
